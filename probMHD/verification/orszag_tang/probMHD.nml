!=====================================================================
! probMHD name list - Orszag-Tang vortex, periodic unit square, 256 x 256
!=====================================================================
$Case_title
  Mode                 = 0
  Case_name            = "OrszagTang"
/end

$Control
  Units                = 1
  Del_T                = 0.0
  End_T                = 0.5
  CFL                  = 0.4
  Gamma                = 1.6666666666666667
/end

$Grid
  Grid_format          = 3
  Ncell                = 256, 256, 1
  Box_min              = 0.0, 0.0, 0.0
  Box_max              = 1.0, 1.0, 0.00390625
  Periodic             = 1, 1, 1
/end

$Initial_Condition
  IC_type              = 2
/end

$Numerical_Scheme
  Cnvt_scheme          = 4
  Riemann_solver       = 3
  Time_scheme          = 3
  CT_scheme            = 1
/end

$Export_Interval
  Output_Intvl         = 0
  Log_Intvl            = 100
  Monitor_Intvl        = 10
  Output_slice         = 1
/end
